MOT_API_KEY=
MOT_UI_USERNAME=admin
MOT_UI_PASSWORD=
MOT_SESSION_SECRET=
DATABASE_URL=./mot.db
BACKUP_PATH=./backups

# Track 5 — semantic/vector retrieval (all optional; sane defaults if unset).
# SQLITE_VEC_PATH: override the sqlite-vec loadable-extension path (default: auto-resolved
#   from the installed platform package). Set only if the extension lives somewhere custom.
# EMBEDDING_CACHE_DIR: where fastembed downloads/caches the ~90MB model (default: ./.model-cache).
# EMBED_INLINE: 'false' defers turn embedding to the session-close digest sweep instead of
#   embedding each turn inline (default: inline). Leave blank for inline.
SQLITE_VEC_PATH=
# EMBED_ENRICH_MAX_CHARS: turns shorter than this get their preceding IN-SESSION turn prepended
#   to the embed input, so a short turn ("ok ship it") is retrievable by its subject instead of
#   its shape. Stored content and the FTS index are never touched. Default 200, measured against
#   the live corpus 2026-09-17 (67% of turns and 95% of USER turns fall under it). A junk or
#   non-positive value falls back to the default. Read at call time: no redeploy to retune.
# EMBED_ENRICH_PREV_CHARS: how much of the preceding turn's TAIL to prepend (default 512).
#
# Changing either knob changes the embed-input representation. Bump EMBED_VERSION in
# lib/embed-input.ts when you do, then re-run `npm run backfill:embeddings` so stored vectors
# are recomputed under the new rule; until they are, mixed-representation vectors stay scorable
# rather than blacking out semantic search.
EMBEDDING_CACHE_DIR=
EMBED_INLINE=
EMBED_ENRICH_MAX_CHARS=
EMBED_ENRICH_PREV_CHARS=
# VECTOR_DISTANCE_FLOOR: max vec0 L2 distance a conversation_vec KNN hit may have and still count
#   as relevant (default 0.76, measured on conversation turns 2026-09-18; derivation in lib/vec.ts).
#   Applies to conversation_vec ONLY. Set it above the metric maximum (e.g. 99) to disable.
# VECTOR_DISTANCE_FLOOR_<TABLE>: a per-store floor, e.g. VECTOR_DISTANCE_FLOOR_ENTITY_VEC=0.8.
#   entity_vec / memory_items_vec / session_digest_vec have NO floor until one is set here (#65):
#   the 0.76 was measured on turn text and does not transfer to entity or memory text.
VECTOR_DISTANCE_FLOOR=
VECTOR_DISTANCE_FLOOR_ENTITY_VEC=

# Tracks 9–11 — Maintainer (nightly resolution + dedup + autoconfirm + profile workers). Set any
# *_DISABLE to '1' to skip that worker without a deploy (FR-14): the 02:00 cron logs one skip line
# and never calls that worker. Leave blank to keep all running.
MAINTAINER_RESOLUTION_DISABLE=
MAINTAINER_DEDUP_DISABLE=
MAINTAINER_AUTOCONFIRM_DISABLE=
MAINTAINER_PROFILE_DISABLE=
# Auto-confirm (Track 11) promotion gate — both read at call time, tune without a redeploy.
# MAINTAINER_AUTOCONFIRM_MIN_CONFIDENCE: confidence floor to promote a candidate (default: 0.9).
# MAINTAINER_AUTOCONFIRM_MIN_AGE_DAYS: min age since valid_from before promotion (default: 7).
MAINTAINER_AUTOCONFIRM_MIN_CONFIDENCE=
MAINTAINER_AUTOCONFIRM_MIN_AGE_DAYS=

# LLM provider seam (lib/llm-provider.ts, novadiem-engineering standard 14) for the resolution/
# dedup/profile workers' identifyViaClaude calls. Read at CALL time — tunable without a redeploy.
# MAINTAINER_LLM_PROVIDER: 'claude-cli' (default) shells out to the project-local `claude` CLI
#   (bundled as an @anthropic-ai/claude-code dependency so it exists in the built container) on
#   Robin's own subscription — needs CLAUDE_CODE_OAUTH_TOKEN (or an already-authed ~/.claude) in
#   the environment. This is MOT's standing backend. 'openrouter' routes the same prompts through
#   OpenRouter instead, but is BLOCKED unless MAINTAINER_OPENROUTER_ALLOW=1 is ALSO set (below).
# MAINTAINER_OPENROUTER_ALLOW: spend guard. OPENROUTER_API_KEY is a SHARED key that funds other
#   production sites, and MOT's nightly drained it on 2026-09-21. Without this set to exactly '1',
#   MAINTAINER_LLM_PROVIDER=openrouter is ignored (one warning per process) and calls run on
#   headless Claude. Set it only as a deliberate decision to put MOT on the shared budget.
# CLAUDE_CODE_OAUTH_TOKEN: only used by the claude-cli backend. Mint with `claude setup-token`
#   (interactive OAuth login — must be run by Robin, not automatable).
# OPENROUTER_API_KEY: only used by the openrouter backend (~/Documents/novadiem/keys/novadiem/openrouter.env).
# MAINTAINER_OPENROUTER_MODEL: override the default cheap model (default: anthropic/claude-haiku-4.5).
# MAINTAINER_OPENROUTER_MAX_TOKENS: output-token cap sent as max_tokens (default: 8192). OpenRouter
#   pre-checks the balance against max_tokens and, with none sent, reserves the model's full output
#   ceiling (64k for haiku-4.5) — so a low balance rejects EVERY batch before it runs. Every worker
#   prompt returns compact JSON over a ≤25-entity batch, so 8192 is ample; only raise it if a
#   response is actually truncated (the batch then fails JSON extraction, not the credit check).
MAINTAINER_LLM_PROVIDER=
MAINTAINER_OPENROUTER_ALLOW=
CLAUDE_CODE_OAUTH_TOKEN=
OPENROUTER_API_KEY=
MAINTAINER_OPENROUTER_MODEL=
MAINTAINER_OPENROUTER_MAX_TOKENS=

# Track 7 — Proactive surfacing (all optional; surfacing is default-OFF).
# SURFACING_ENABLE: set to '1' to enable nightly Deadline nudges; unset or '0' = off.
# SURFACING_SEND_HOUR: daytime cron hour in the configured local timezone (default: 8).
# SURFACING_TZ: IANA timezone for quiet-hours and days-out math (default: America/Vancouver).
# SURFACING_QUIET_START: start of the quiet window, local hour (default: 21).
# SURFACING_QUIET_END: end of the quiet window, local hour, half-open (default: 8).
# SURFACING_RATE_CAP: max surfacing Telegram messages per daily run (default: 3).
# SURFACING_MIN_CONFIDENCE: entity confidence floor (default: 0.85, same as extraction gate).
SURFACING_ENABLE=
SURFACING_SEND_HOUR=
SURFACING_TZ=
SURFACING_QUIET_START=
SURFACING_QUIET_END=
SURFACING_RATE_CAP=
SURFACING_MIN_CONFIDENCE=

# Deploy-drift alarm (lib/deploy-drift.ts) — nightly "is the running container actually main?"
# check. Zero config in production: Coolify already sets SOURCE_COMMIT and COOLIFY_BRANCH, and the
# repo is public so the GitHub read needs no token. Outside a deployed container (local dev, CI)
# there is no deployed sha, so the check skips itself and nothing pages. All read at call time.
# MOT_DEPLOY_DRIFT_DISABLE: '1' turns the nightly check off entirely (mirrors MAINTAINER_*_DISABLE).
#   The deploy_drift_check MCP tool still works — it is read-only and files no tickets.
# MOT_DEPLOY_DRIFT_ENABLE: '1' makes a MISSING deployed sha an alert instead of a quiet skip. Set
#   this in production, so that Coolify dropping SOURCE_COMMIT some day surfaces as a broken check
#   rather than as a monitor that silently stopped monitoring. Leave blank everywhere else.
# MOT_DEPLOY_DRIFT_GRACE_MINUTES: a branch head younger than this is treated as mid-deploy rather
#   than as drift (default: 30).
# MOT_DEPLOY_REPO: owner/repo to read the branch head from (default: rheos/mot).
# MOT_DEPLOY_BRANCH: branch to compare against (default: COOLIFY_BRANCH, else main).
# MOT_DEPLOYED_SHA: override the deployed sha instead of reading SOURCE_COMMIT (testing, or a host
#   that is not Coolify).
# MOT_GITHUB_TOKEN: optional. The unauthenticated GitHub budget is 60 requests/hour PER IP and this
#   costs at most two a night, but that budget is shared with everything else on the box — and a
#   token becomes required if the repo ever goes private. GITHUB_TOKEN is used as a fallback.
MOT_DEPLOY_DRIFT_DISABLE=
MOT_DEPLOY_DRIFT_ENABLE=
MOT_DEPLOY_DRIFT_GRACE_MINUTES=
MOT_DEPLOY_REPO=
MOT_DEPLOY_BRANCH=
MOT_DEPLOYED_SHA=
MOT_GITHUB_TOKEN=
